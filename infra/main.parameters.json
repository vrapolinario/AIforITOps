{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "foundryLocation": {
      "value": "${AZURE_FOUNDRY_LOCATION=westus}"
    },
    "managedIdentityName": {
      "value": "${AZURE_MANAGED_IDENTITY_NAME=}"
    },
    "containerRegistryName": {
      "value": "${AZURE_CONTAINER_REGISTRY_NAME=}"
    },
    "aksClusterName": {
      "value": "${AZURE_AKS_CLUSTER_NAME=}"
    },
    "cosmosDbAccountName": {
      "value": "${AZURE_COSMOSDB_ACCOUNT_NAME=}"
    },
    "serviceBusNamespaceName": {
      "value": "${AZURE_SERVICEBUS_NAMESPACE=}"
    },
    "keyVaultName": {
      "value": "${AZURE_KEY_VAULT_NAME=}"
    },
    "foundryResourceName": {
      "value": "${AZURE_FOUNDRY_RESOURCE_NAME=}"
    },
    "foundryProjectName": {
      "value": "${AZURE_FOUNDRY_PROJECT_NAME=aifor-itops}"
    },
    "foundryModelDeploymentName": {
      "value": "${AZURE_FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o}"
    },
    "foundryModelName": {
      "value": "${AZURE_FOUNDRY_MODEL_NAME=gpt-4o}"
    },
    "foundryModelVersion": {
      "value": "${AZURE_FOUNDRY_MODEL_VERSION=2024-11-20}"
    },
    "foundryModelSkuName": {
      "value": "${AZURE_FOUNDRY_MODEL_SKU_NAME=GlobalStandard}"
    },
    "foundryModelCapacity": {
      "value": "${AZURE_FOUNDRY_MODEL_CAPACITY=10}"
    },
    "aksKubernetesVersion": {
      "value": "${AZURE_AKS_KUBERNETES_VERSION=}"
    },
    "aksNodePoolVmSize": {
      "value": "${AZURE_AKS_NODE_POOL_VM_SIZE=Standard_D2s_v3}"
    },
    "aksSystemNodeCount": {
      "value": "${AZURE_AKS_SYSTEM_NODE_COUNT=2}"
    },
    "aksUserNodeCount": {
      "value": "${AZURE_AKS_USER_NODE_COUNT=2}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    }
  }
}
